{
  "name": "darknite",
  "version": "3.0.0",
  "description": "DarkNite Command Center - Powered by JARVIS. 7,219 AI skills, agents, and commands.",
  "main": "main.js",
  "author": "DarkNite",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable",
    "build-mac": "electron-builder --mac",
    "build-all": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.darknite.commandcenter",
    "productName": "DarkNite",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dfnine9",
        "repo": "darknite"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "src/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "DarkNite-Installer-${version}.exe",
      "shortcutName": "DarkNite"
    },
    "portable": {
      "artifactName": "DarkNite-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "src/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "DarkNite-${version}-mac.${ext}",
      "identity": null
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "src/icon.png",
      "artifactName": "DarkNite-${version}-linux.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
